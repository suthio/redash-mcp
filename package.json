{
  "name": "@suthio/redash-mcp",
  "version": "0.0.14",
  "description": "MCP server for Redash integration",
  "homepage": "https://github.com/suthio/redash-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suthio/redash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/suthio/redash-mcp/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "redash-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector node dist/index.js",
    "inspector:headless": "BROWSER=none pnpm dlx @modelcontextprotocol/inspector node dist/index.js",
    "e2e:test": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "redash",
    "mcp",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.57.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
