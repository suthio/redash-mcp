# Redash Instance URL (required)
REDASH_URL=https://your-redash-instance.com

# Redash API Key (required)
REDASH_API_KEY=your_api_key

# Optional: Timeout for API requests in milliseconds
REDASH_TIMEOUT=30000

# Optional: Maximum number of results to return
REDASH_MAX_RESULTS=1000

# Optional: Extra HTTP headers (JSON or key=value;key2=value2)
# Example for Cloudflare Access:
# REDASH_EXTRA_HEADERS='{"CF-Access-Client-Id":"your_client_id","CF-Access-Client-Secret":"your_client_secret"}'

# Optional: export traces, metrics, and logs to an OpenTelemetry Collector.
# No telemetry network connection is made while these settings are commented out.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional: expose Prometheus metrics.
# HTTP transport: served at GET /metrics on the MCP HTTP listener.
# OTEL_METRICS_EXPORTER=prometheus
# stdio transport also requires a separate listener:
# OTEL_EXPORTER_PROMETHEUS_HOST=127.0.0.1
# OTEL_EXPORTER_PROMETHEUS_PORT=9464

# Tool arguments/results (including SQL, query settings, rows, and CSV) and
# Redash error bodies are omitted by default. Enable only when the trace and
# log backends are approved to store that content. Credentials stay excluded.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
